          "editorMode": "code",
          "expr": "topk($topk,\n  sum by (client, server) (\n    rate(traces_service_graph_request_total{client_k8s_cluster_name=~\"$cluster\", server_k8s_cluster_name=~\"$cluster\", client_k8s_namespace_name=~\"$namespace\", server_k8s_namespace_name=~\"$namespace\", client!=\"\", server!=\"\"}[$__range])\n  )\n)",
          "exemplar": false,
