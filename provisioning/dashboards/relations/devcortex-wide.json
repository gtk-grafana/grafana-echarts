    {
      "id": 6,
      "type": "grafana-echartsrelations-panel",
      "title": "Where the pivot stops: node stats — graph",
      "description": "The edge query needs no dashboard transformations. The node error-ratio query uses Organize fields and Rows to fields because it has only one endpoint label.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "h": 12,
        "w": 12,
        "x": 12,
        "y": 44
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "filterable": true
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/-->/"
            },
            "properties": [
              {
                "id": "unit",
                "value": "reqps"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "color",
                "value": {
                  "mode": "palette-classic"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "seriesType": "graph",
        "editorMode": "advanced",
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "single"
        },
        "relationsFocusAdjacency": true,
        "relationsLayout": "circular",
        "relationsEdgeArrows": true,
        "relationsNodeSize": 18,
        "relationsCurveness": 0.1,
        "relationsLinkColor": "target",
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "topk($topk,\n  sum by (client, server) (\n    rate(traces_service_graph_request_total{client_k8s_cluster_name=~\"$cluster\", client_k8s_namespace_name=~\"$namespace\", client=~\"$client\", server=~\"$server\", client!=\"\", server!=\"\"}[$__range])\n  )\n)",
          "exemplar": false,
          "format": "time_series",
          "instant": false,
          "range": true,
          "legendFormat": "__auto"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "(\n    sum by (server) (rate(traces_service_graph_request_failed_total{client_k8s_cluster_name=~\"$cluster\", client_k8s_namespace_name=~\"$namespace\", client=~\"$client\", server=~\"$server\", client!=\"\", server!=\"\"}[$__range]))\n  / sum by (server) (rate(traces_service_graph_request_total{client_k8s_cluster_name=~\"$cluster\", client_k8s_namespace_name=~\"$namespace\", client=~\"$client\", server=~\"$server\", client!=\"\", server!=\"\"}[$__range]))\n)\nand on (server)\nsum by (server) (\n  topk($topk,\n    sum by (client, server) (\n      rate(traces_service_graph_request_total{client_k8s_cluster_name=~\"$cluster\", client_k8s_namespace_name=~\"$namespace\", client=~\"$client\", server=~\"$server\", client!=\"\", server!=\"\"}[$__range])\n    )\n  )\n)",
          "exemplar": false,
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "__auto"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "filter": {
            "id": "byRefId",
            "options": "B"
          },
          "options": {
            "excludeByName": {
              "Time": true
            }
          }
        },
        {
          "id": "rowsToFields",
          "filter": {
            "id": "byRefId",
            "options": "B"
          },
          "options": {}
        }
      ]
    },
    {
