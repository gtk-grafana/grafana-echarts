    {
      "id": 4,
      "type": "grafana-echartsrelations-panel",
      "title": "Range \u2192 text on an edge weight",
      "description": "Range mappings change the edge values `120`, `80`, and `45` to `saturated`, `busy`, and `light`. Show edge values displays the mapped text on each link. The node values stay numeric.",
      "datasource": {
        "type": "grafana-testdata-datasource",
        "uid": "trlxrdZVk"
      },
      "gridPos": {
        "h": 11,
        "w": 8,
        "x": 0,
        "y": 11
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*-->.*"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "range",
                    "options": {
                      "from": 0,
                      "to": 50,
                      "result": {
                        "text": "light",
                        "index": 0
                      }
                    }
                  },
                  {
                    "type": "range",
                    "options": {
                      "from": 50,
                      "to": 100,
                      "result": {
                        "text": "busy",
                        "index": 1
                      }
                    }
                  },
                  {
                    "type": "range",
                    "options": {
                      "from": 100,
                      "to": 100000,
                      "result": {
                        "text": "saturated",
                        "index": 2
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
